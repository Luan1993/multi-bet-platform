# ============================================================
# Configuração da Plataforma Multi-Bet
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================

# Ambiente: development | production | test
NODE_ENV=development

# Porta da API
PORT=4000

# ------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# Deixe vazio para usar o PostgreSQL local portátil (dev/testes).
# Em produção, cole a URL do seu servidor PostgreSQL online
# (ex.: Neon, Supabase, Railway, Aiven — free tier):
#   postgresql://user:password@host:5432/dbname?sslmode=require
#
# Neon: use a URL pooled em DATABASE_URL (tráfego da API) e a URL direta
# em DATABASE_URL_UNPOOLED (migrações, seed e backup).
# ------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Pasta de dados do PostgreSQL portátil local (apenas desenvolvimento)
PG_LOCAL_DIR=.pgdata

# ------------------------------------------------------------
# PROVEDOR DE DADOS ESPORTIVOS / ODDS
# provider: the-odds-api | api-football | football-data | demo | none
# ------------------------------------------------------------
ODDS_PROVIDER=demo
# The Odds API (https://the-odds-api.com) — odds automáticas.
# Plano grátis: 500 créditos/mês (custo = mercados x regiões x liga por sync).
THE_ODDS_API_KEY=
# Ligas monitoradas (chaves da API, separadas por vírgula).
THE_ODDS_API_SPORTS=soccer_brazil_campeonato,soccer_conmebol_copa_libertadores,soccer_epl
# Mercados: h2h (resultado final) e totals (mais/menos gols).
THE_ODDS_API_MARKETS=h2h,totals
THE_ODDS_API_REGIONS=eu
# Intervalo mínimo entre consultas reais (minutos). No plano grátis use >= 540.
THE_ODDS_API_CACHE_MINUTES=540
# Preencha com sua chave real ao usar o provedor api-football.
API_FOOTBALL_KEY=
# football-data.org: a chave gratuita não inclui odds (ver DEPLOY.md).
FOOTBALL_DATA_KEY=

# Intervalo mínimo (ms) entre sincronizações de odds por evento (protege a cota diária)
ODDS_REFRESH_MS=600000

# Validade das odds (minutos) antes de bloquear a confirmação de cupons.
# Com cache de 9h na The Odds API, use 600.
ODDS_STALE_MINUTES=30

# Máximo de eventos com odds sincronizados por rodada (plano Free: 100 req/dia)
ODDS_SYNC_MAX_FIXTURES=15

# ------------------------------------------------------------
# MODO DEMONSTRAÇÃO (sem dinheiro real)
# true = sistema opera em modo simulado, claramente sinalizado na interface
# ------------------------------------------------------------
DEMO_MODE=true

# ------------------------------------------------------------
# SEGURANÇA
# ------------------------------------------------------------
# Segredo para derivação de tokens (gere um novo em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Duração da sessão (horas)
SESSION_TTL_HOURS=12

# URL pública base (usada em links de recibo/QR). Em produção, o domínio real.
PUBLIC_BASE_URL=http://localhost:5173

# ------------------------------------------------------------
# LIMITES GLOBAIS DE RISCO (centavos). 500000 = R$ 5.000,00
# Cada bet pode configurar um limite igual ou menor.
# ------------------------------------------------------------
GLOBAL_MAX_PAYOUT_CENTS=500000
GLOBAL_MIN_STAKE_CENTS=100
GLOBAL_MAX_STAKE_CENTS=100000

# Expiração (horas) de cupons pendentes não confirmados
PENDING_COUPON_EXPIRY_HOURS=24
