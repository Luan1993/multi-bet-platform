# ============================================================
# Produção via Docker Compose (VPS / Oracle Cloud / etc.)
# Copie para .env.production e preencha com valores fortes.
# Uso: docker compose --env-file .env.production up -d --build
# ============================================================

# Senha do PostgreSQL local do compose
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Segredo de sessão (48 bytes hex). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Senhas iniciais (o seed só as usa quando o banco está vazio)
ADMIN_PASSWORD=
SELLER01_PASSWORD=
SELLER02_PASSWORD=

# URL pública usada em recibos e QR. Com HTTPS, use https://...
PUBLIC_BASE_URL=http://localhost:4000

# Modo demonstração (não movimenta dinheiro real)
DEMO_MODE=true
ODDS_PROVIDER=demo
